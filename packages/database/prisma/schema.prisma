generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./report.db"
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String?
  createdAt DateTime  @default(now())

  jobs      ReportJob[]
  datasets  Dataset[]
}

model Dataset {
  id          String   @id @default(uuid())
  userId      String
  name        String
  currency    String   @default("USD")
  rowCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]
  jobs        ReportJob[]

  @@index([userId])
}

model Order {
  id           String      @id @default(uuid())
  datasetId    String
  customerName String
  amount       Float
  status       String
  createdAt    DateTime    @default(now())

  dataset      Dataset     @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@index([createdAt])
  @@index([status])
}

model ReportJob {
  id             String    @id @default(uuid())
  userId         String
  datasetId      String
  reportType     String
  status         String    @default("QUEUED")
  fromDate       DateTime
  toDate         DateTime
  progress       Int       @default(0)
  attempts       Int       @default(0)
  errorMessage   String?
  artifactId     String?   @unique
  idempotencyKey String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  dataset        Dataset         @relation(fields: [datasetId], references: [id])
  artifact       ReportArtifact? @relation(fields: [artifactId], references: [id])

  @@index([userId])
  @@index([datasetId])
  @@index([status])
  @@index([createdAt])
  @@index([idempotencyKey])
}

model ReportArtifact {
  id          String   @id @default(uuid())
  jobId       String   @unique
  fileName    String
  storagePath String
  mimeType    String
  fileSize    Int
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  job         ReportJob?
}
