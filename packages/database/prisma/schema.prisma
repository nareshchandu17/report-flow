generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./report.db"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())

  jobs      ReportJob[]
}



model Order {
  id           String      @id @default(uuid())
  customerName String
  amount       Float
  status       String
  createdAt    DateTime    @default(now())

  @@index([createdAt])
  @@index([status])
}



model ReportJob {
  id             String    @id @default(uuid())
  userId         String
  reportType     String
  status         String    @default("QUEUED")
  fromDate       DateTime
  toDate         DateTime
  progress       Int       @default(0)
  attempts       Int       @default(0)
  errorMessage   String?
  artifactId     String?   @unique
  idempotencyKey String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  artifact       ReportArtifact? @relation(fields: [artifactId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([idempotencyKey])
}

model ReportArtifact {
  id          String   @id @default(uuid())
  jobId       String   @unique
  fileName    String
  storagePath String
  mimeType    String
  fileSize    Int
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  job         ReportJob?
}
